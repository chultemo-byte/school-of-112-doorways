{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chultemo-byte/school-of-112-doorways/schema/door.schema.json",
  "title": "Door",
  "type": "object",
  "required": [
    "door_id", "sanskrit", "iast", "english", "house",
    "dimension_name", "geometry", "reaction", "breath",
    "orientation", "attention", "color", "bija",
    "octaves", "ways", "guardian", "safety"
  ],
  "properties": {
    "door_id": { "type": "string", "pattern": "^(0[0-9]{2}|1[0-1][0-9]|112|A[0-9]+)$" },
    "sanskrit": { "type": "string" },
    "iast": { "type": "string" },
    "english": { "type": "string" },
    "house": { "type": "integer", "minimum": 1, "maximum": 7 },
    "axis": { "type": "array", "items": { "type": "integer" } },
    "dimension_name": { "type": "string" },
    "geometry": {
      "type": "object",
      "required": ["polygon", "contact_points"],
      "properties": {
        "polygon": { "type": "string" },
        "axis_lines": { "type": "array", "items": { "type": "string" } },
        "contact_points": { "type": "array", "items": { "type": "string" } }
      }
    },
    "reaction": {
      "type": "object",
      "required": ["reactants", "catalyst", "precipitate"],
      "properties": {
        "reactants": { "type": "string" },
        "catalyst": { "type": "string" },
        "precipitate": { "type": "string" },
        "caution": { "type": "string" }
      }
    },
    "breath": {
      "type": "object",
      "required": ["name", "inhale", "exhale"],
      "properties": {
        "name": { "type": "string" },
        "inhale": { "type": "string" },
        "exhale": { "type": "string" },
        "ratio": { "type": "string" },
        "bandha": { "type": "string" },
        "sound": { "type": "string" }
      }
    },
    "orientation": {
      "type": "object",
      "required": ["enter", "gaze"],
      "properties": {
        "enter": { "type": "array", "items": { "type": "string" } },
        "gaze": { "type": "string" },
        "lead_joint": { "type": "string" },
        "follow_joint": { "type": "string" },
        "props": { "type": "array", "items": { "type": "string" } }
      }
    },
    "attention": {
      "type": "object",
      "required": ["locus", "chakra"],
      "properties": {
        "locus": { "type": "string" },
        "chakra": { "type": "string" },
        "satellite": { "type": "string" },
        "failure_mode": { "type": "string" }
      }
    },
    "color": { "type": "string" },
    "color_hex": { "type": "string" },
    "bija": { "type": "string" },
    "mantra_use": { "type": "string" },
    "octaves": {
      "type": "object",
      "properties": {
        "enter": { "type": "string" },
        "refine": { "type": "string" },
        "dissolve": { "type": "string" }
      }
    },
    "ways": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "string" } },
    "guardian": {
      "type": "object",
      "required": ["name", "opening_line"],
      "properties": {
        "name": { "type": "string" },
        "opening_line": { "type": "string" },
        "voice": { "type": "string" }
      }
    },
    "safety": { "type": "array", "items": { "type": "string" } },
    "vbt_companion": { "type": "string" },
    "cartoon_beats": { "type": "array", "items": { "type": "string" } }
  }
}
