{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://school-of-112-doorways.local/schemas/door.schema.json",
  "title": "Door",
  "$comment": "research-door schema v2.0.0 (2026-10-06). v2.0.0 adds the VBT-dharana framing for House 1: door N = Vijñāna Bhairava Tantra dharana N (Jaideva Singh numbering). All v1.0.0 fields are kept and still required, so v1 doors still validate. A door that declares schema_version 2.0.0 must also carry dharana, practice_mode, framing, seat, previous_label and previous_file. Changelog: schemas/RESEARCH-DOOR-SCHEMA.md.",
  "description": "House 1 research door. Schema version 2.0.0 (previous: 1.0.0, unversioned).",
  "type": "object",
  "required": [
    "id",
    "name",
    "house",
    "status",
    "geometry",
    "reaction",
    "breath",
    "orientation",
    "attention",
    "adiyogi",
    "honesty",
    "safety",
    "sources",
    "beats",
    "researcher"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^D-(0[0-9]{2}|10[0-9]|11[0-2])$"
    },
    "schema_version": {
      "enum": [
        "2.0.0"
      ],
      "description": "Door format version. Absent = v1.0.0 (posture framing)."
    },
    "framing": {
      "enum": [
        "vbt_dharana"
      ],
      "description": "v2: the door's content is a VBT dharana; any posture is an optional school device (see seat)."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "v2: the technique name of the dharana (same as dharana.technique_name)."
    },
    "sanskrit": {
      "type": "string",
      "description": "v2: a short IAST tag phrase quoted from the verse. v1: the posture's Sanskrit name."
    },
    "house": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "status": {
      "enum": [
        "stub",
        "draft",
        "researched",
        "live"
      ]
    },
    "practice_mode": {
      "enum": [
        "practice",
        "historical/observe_only"
      ],
      "description": "v2 top-level mode. Sexual, extreme, breath-retention-heavy or otherwise risky techniques are historical/observe_only and need a safety.observe_only_note."
    },
    "previous_label": {
      "type": "string",
      "minLength": 1,
      "description": "Traceability: the retired v1 label, e.g. 'Tadasana — Mountain (asana framing, retired 2026-10)'. The only field allowed to carry a posture name."
    },
    "previous_file": {
      "type": "string",
      "minLength": 1,
      "description": "Traceability: path and commit of the retired v1 door file."
    },
    "previous_vbt_ref": {
      "type": "string",
      "description": "The v1 adiyogi.vbt_ref, marked '(superseded)' if the verse changed."
    },
    "dharana": {
      "type": "object",
      "required": [
        "number",
        "verses",
        "numbering_edition",
        "sanskrit_iast",
        "sanskrit_status",
        "rendering",
        "rendering_kind",
        "technique_name",
        "category",
        "verification"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 112
        },
        "verses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 163
          }
        },
        "numbering_edition": {
          "type": "string"
        },
        "sanskrit_iast": {
          "type": "string",
          "minLength": 1
        },
        "sanskrit_source": {
          "type": "string"
        },
        "sanskrit_status": {
          "enum": [
            "verified",
            "partial",
            "unverified"
          ]
        },
        "sanskrit_variants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rendering": {
          "type": "string",
          "minLength": 1
        },
        "rendering_kind": {
          "enum": [
            "paraphrase",
            "quote"
          ]
        },
        "rendering_attribution": {
          "type": "string"
        },
        "commentary_note": {
          "type": "string"
        },
        "technique_name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "breath",
            "visualization",
            "sensation",
            "concentration",
            "sound",
            "emptiness/space",
            "devotion",
            "everyday activity",
            "other"
          ]
        },
        "category_secondary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verification": {
          "type": "object",
          "required": [
            "status",
            "checked_against"
          ],
          "properties": {
            "status": {
              "enum": [
                "verified",
                "partial",
                "unverified"
              ]
            },
            "checked_against": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "numbering_variants": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "seat": {
      "type": "object",
      "required": [
        "school_device",
        "summary",
        "honesty"
      ],
      "properties": {
        "school_device": {
          "const": true
        },
        "label": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "honesty": {
          "type": "string"
        }
      }
    },
    "geometry": {
      "type": "object",
      "required": [
        "polygon",
        "summary"
      ],
      "properties": {
        "polygon": {
          "type": "string"
        },
        "joints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string"
        },
        "svg_hint": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "body_shape",
            "attention_map"
          ],
          "description": "v2: attention_map = the dharana's own spatial map, not a body shape. Absent = body_shape (v1)."
        },
        "points": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "honesty": {
          "type": "string"
        }
      }
    },
    "reaction": {
      "type": "object",
      "required": [
        "name",
        "from_phase",
        "to_phase",
        "summary"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "from_phase": {
          "type": "string"
        },
        "to_phase": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "breath": {
      "type": "object",
      "required": [
        "inhale",
        "hold",
        "exhale",
        "cycles",
        "lands_in",
        "cue"
      ],
      "properties": {
        "inhale": {
          "type": "number"
        },
        "hold": {
          "type": "number"
        },
        "exhale": {
          "type": "number"
        },
        "cycles": {
          "type": "integer"
        },
        "lands_in": {
          "type": "string"
        },
        "cue": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "natural",
            "sounded_exhale",
            "paced"
          ],
          "description": "v2: counts are an optional school pacing aid; natural breath is the default."
        },
        "honesty": {
          "type": "string"
        }
      }
    },
    "orientation": {
      "type": "object",
      "required": [
        "cue",
        "gravity"
      ],
      "properties": {
        "cue": {
          "type": "string"
        },
        "gravity": {
          "type": "string"
        },
        "gaze": {
          "type": "string"
        },
        "degrees_hint": {
          "type": "string"
        }
      }
    },
    "attention": {
      "type": "object",
      "required": [
        "primary"
      ],
      "properties": {
        "primary": {
          "type": "string"
        },
        "secondary": {
          "type": "string"
        },
        "chakra": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "adiyogi": {
      "type": "object",
      "required": [
        "vbt_ref",
        "method_summary",
        "practice_mode"
      ],
      "properties": {
        "vbt_ref": {
          "type": "string"
        },
        "verse_paraphrase": {
          "type": "string"
        },
        "method_summary": {
          "type": "string"
        },
        "practice_mode": {
          "enum": [
            "practice",
            "observe_only",
            "historical"
          ]
        },
        "historical_extreme": {
          "type": "boolean"
        },
        "sexual_content": {
          "type": "boolean"
        }
      }
    },
    "honesty": {
      "type": "object",
      "required": [
        "pairing_type",
        "disclosure"
      ],
      "properties": {
        "pairing_type": {
          "enum": [
            "school_device",
            "inner_logic",
            "axis_pairing"
          ]
        },
        "disclosure": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "v2: append-only list of honesty flags."
        },
        "legacy": {
          "type": "object",
          "description": "v2: the v1 disclosure and notes, kept (posture names redacted; verbatim text at previous_file)."
        }
      }
    },
    "safety": {
      "type": "object",
      "required": [
        "pain_rule",
        "never_force",
        "contraindication_notes"
      ],
      "properties": {
        "pain_rule": {
          "type": "string"
        },
        "never_force": {
          "type": "boolean"
        },
        "open_seat_alternate": {
          "type": [
            "string",
            "null"
          ]
        },
        "contraindication_notes": {
          "type": "string"
        },
        "legacy_notes": {
          "type": "object",
          "description": "v2: the v1 posture-specific safety notes, kept for traceability."
        },
        "observe_only_note": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "label",
          "kind"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "vbt",
              "asana",
              "commentary",
              "school",
              "other"
            ]
          },
          "ref": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "n",
          "title",
          "script"
        ],
        "properties": {
          "n": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "script": {
            "type": "string"
          }
        }
      }
    },
    "researcher": {
      "type": "string"
    },
    "researched_at": {
      "type": "string"
    },
    "reframed_by": {
      "type": "string"
    },
    "reframed_at": {
      "type": "string"
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "previous_review": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "schema_version"
        ],
        "properties": {
          "schema_version": {
            "const": "2.0.0"
          }
        }
      },
      "then": {
        "required": [
          "framing",
          "practice_mode",
          "previous_label",
          "previous_file",
          "dharana",
          "seat"
        ],
        "properties": {
          "breath": {
            "properties": {
              "hold": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "practice_mode"
        ],
        "properties": {
          "practice_mode": {
            "const": "historical/observe_only"
          }
        }
      },
      "then": {
        "properties": {
          "adiyogi": {
            "properties": {
              "practice_mode": {
                "enum": [
                  "observe_only",
                  "historical"
                ]
              }
            }
          },
          "safety": {
            "required": [
              "observe_only_note"
            ]
          }
        }
      }
    }
  ]
}
