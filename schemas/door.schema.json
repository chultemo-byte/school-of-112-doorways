{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/chultemo-byte/school-of-112-doorways/schemas/door.schema.json",
  "title": "Door",
  "description": "One doorway in the School of 112 Doorways. Reaction is a teaching metaphor, not laboratory chemistry. Breath numbers are equal counts (a comfortable pulse), not clock seconds.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "number",
    "sanskrit",
    "english",
    "house",
    "element",
    "color",
    "bija",
    "geometry",
    "reaction",
    "breath",
    "orientation",
    "attention",
    "adiyogi_method",
    "guardian",
    "safety_notes",
    "five_ways"
  ],
  "properties": {
    "number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 112
    },
    "sanskrit": { "type": "string", "minLength": 1 },
    "english": { "type": "string", "minLength": 1 },
    "house": { "type": "string", "minLength": 1 },
    "element": { "type": "string", "minLength": 1 },
    "color": { "type": "string", "minLength": 1 },
    "bija": { "type": "string", "minLength": 1 },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["polygon", "vertices"],
      "properties": {
        "polygon": { "type": "string", "minLength": 1 },
        "vertices": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": { "type": "number" }
          }
        },
        "units": { "type": "string" }
      }
    },
    "reaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reactants", "catalyst", "product", "phase"],
      "properties": {
        "reactants": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "catalyst": { "type": "string", "minLength": 1 },
        "product": { "type": "string", "minLength": 1 },
        "phase": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    },
    "breath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inhale", "exhale", "pause", "bandha"],
      "properties": {
        "inhale": { "type": "number", "minimum": 0 },
        "exhale": { "type": "number", "minimum": 0 },
        "pause": { "type": "number", "minimum": 0 },
        "bandha": { "type": "string", "minLength": 1 },
        "units": { "type": "string" },
        "pause_after": { "enum": ["exhale", "inhale", "none"] }
      }
    },
    "orientation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hand_placement", "gaze", "joint_lead"],
      "properties": {
        "hand_placement": { "type": "string", "minLength": 1 },
        "gaze": { "type": "string", "minLength": 1 },
        "joint_lead": { "type": "string", "minLength": 1 }
      }
    },
    "attention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locus"],
      "properties": {
        "locus": { "type": "string", "minLength": 1 },
        "chakra": { "type": "string" }
      }
    },
    "adiyogi_method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vbt_verse", "summary"],
      "properties": {
        "vbt_verse": { "type": "integer", "minimum": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "yukti": { "type": "integer", "minimum": 1, "maximum": 112 },
        "extreme": {
          "type": "boolean",
          "description": "When true, the dharana stays observe_only until the student profile allows practice."
        }
      }
    },
    "guardian": { "type": "string", "minLength": 1 },
    "safety_notes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "five_ways": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1 },
      "description": "Five teaching approaches for this door."
    },
    "house_intensity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "House intensity the student must already have clearance for."
    },
    "breath_demand": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Breath capacity required before geometry may be entered."
    },
    "requires_lotus": {
      "type": "boolean",
      "description": "True when the door asks for Padmasana. Lotus is never forced."
    }
  }
}
